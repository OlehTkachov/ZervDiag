<Window x:Class="CraneCAN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CraneCAN ONK-160 Test 0.4.1 — стендовый пассивный приёмник"
        Height="760"
        Width="1220"
        MinHeight="560"
        MinWidth="900"
        Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEF3F8" BorderBrush="#C7D2DE" BorderThickness="0,0,0,1" Padding="8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Профиль:" VerticalAlignment="Center" Margin="4" />
                <ComboBox x:Name="ProfileCombo" Width="215" DisplayMemberPath="DisplayName" SelectionChanged="ProfileCombo_SelectionChanged" />
                <TextBlock Text="Источник:" VerticalAlignment="Center" Margin="12,4,4,4" />
                <ComboBox x:Name="DriverCombo" Width="235" DisplayMemberPath="DisplayName" SelectionChanged="DriverCombo_SelectionChanged" />
                <TextBlock Text="Канал/COM:" VerticalAlignment="Center" Margin="12,4,4,4" />
                <ComboBox x:Name="ChannelCombo" Width="170" DisplayMemberPath="DisplayName"
                          IsEditable="True" IsTextSearchEnabled="False"
                          ToolTip="Для ОНК-160 можно ввести номер вручную, например COM4" />
                <Button x:Name="RefreshChannelsButton" Content="Обновить" Click="RefreshChannelsButton_Click" />
                <TextBlock Text="Скорость:" VerticalAlignment="Center" Margin="12,4,4,4" />
                <ComboBox x:Name="BitrateCombo" Width="110" />
                <CheckBox x:Name="ListenOnlyCheck" Content="Только приём" IsChecked="True" IsEnabled="False" VerticalAlignment="Center" Margin="12,4" />
                <Button x:Name="ConnectButton" Content="Подключить" Click="ConnectButton_Click" />
                <Button x:Name="DisconnectButton" Content="Отключить" IsEnabled="False" Click="DisconnectButton_Click" />
                <Button x:Name="OpenCsvButton" Content="Открыть CSV" Click="OpenCsvButton_Click" />
                <Button x:Name="SaveTraceButton" Content="Сохранить CSV" Click="SaveCsvButton_Click" />
                <Button x:Name="ClearTrafficButton" Content="Очистить" Click="ClearButton_Click" />
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Отключено. Передача кадров запрещена." />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="FrameCountText" Text="Сообщений: 0" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8">
            <TabItem Header="Трафик">
                <DataGrid x:Name="FramesGrid" ItemsSource="{Binding Frames}" AutoGenerateColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время UTC" Binding="{Binding TimeText}" Width="175" />
                        <DataGridTextColumn Header="Δt, мс" Binding="{Binding DeltaText}" Width="75" />
                        <DataGridTextColumn Header="Канал" Binding="{Binding Channel}" Width="60" />
                        <DataGridTextColumn Header="Напр." Binding="{Binding Direction}" Width="60" />
                        <DataGridTextColumn Header="Протокол" Binding="{Binding ProtocolText}" Width="105" />
                        <DataGridTextColumn Header="ID/пакет" Binding="{Binding IdText}" Width="90" />
                        <DataGridTextColumn Header="Длина" Binding="{Binding Dlc}" Width="60" />
                        <DataGridTextColumn Header="DATA" Binding="{Binding DataText}" Width="*" />
                        <DataGridTextColumn Header="Тип" Binding="{Binding TypeText}" Width="105" />
                        <DataGridTextColumn Header="Расшифровка" Binding="{Binding DecodedText}" Width="330" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="ОНК-160 — расшифровка">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12" Background="#F5F8FB"
                            BorderBrush="#C7D2DE" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="Текущее состояние" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" />
                            <TextBlock x:Name="OnkStatusText" Text="Нет данных ОНК-160." TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Foreground="#586574" TextWrapping="Wrap"
                                       Text="E55 определяется по эталонному совпадению F7=10 и пока помечается как предварительное. E31 и E83 подтверждены управляемыми испытаниями стенда." />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="OnkPacketsGrid" ItemsSource="{Binding OnkPackets}" AutoGenerateColumns="False"
                              IsReadOnly="True" EnableRowVirtualization="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время UTC" Binding="{Binding TimeText}" Width="175" />
                            <DataGridTextColumn Header="Пакет" Binding="{Binding HeaderText}" Width="70" />
                            <DataGridTextColumn Header="Длина" Binding="{Binding Length}" Width="65" />
                            <DataGridTextColumn Header="Данные" Binding="{Binding DataText}" Width="*" />
                            <DataGridTextColumn Header="Контр. сумма" Binding="{Binding ChecksumText}" Width="115" />
                            <DataGridTextColumn Header="Расшифровка" Binding="{Binding DecodedText}" Width="430" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Стендовые испытания">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12" Margin="0,0,0,8" Background="#F5F8FB"
                            BorderBrush="#C7D2DE" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="Сравнение устойчивых состояний «норма → одно изменение»"
                                       FontWeight="Bold" FontSize="15" />
                            <TextBlock Margin="0,5,0,0" Foreground="#586574" TextWrapping="Wrap"
                                       Text="Сначала запишите норму, затем измените только один электрический сигнал и запишите второе состояние. Программа усредняет 20–50 полных циклов и показывает изменившиеся байты и биты. Приём остаётся полностью пассивным." />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название испытания:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox x:Name="BenchTestNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,2,16,2"
                                 ToolTip="Например: Концевик подъёма крюка" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Электрическое воздействие:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox x:Name="BenchActionTextBox" Grid.Row="0" Grid.Column="3" Margin="0,2"
                                 ToolTip="Что именно изменено на стенде; только один фактор" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Код БОИ:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox x:Name="BenchBoiCodeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,2,16,2"
                                 ToolTip="Например: E83" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Текст БОИ:" VerticalAlignment="Center" Margin="0,4,8,4" />
                        <TextBox x:Name="BenchBoiTextTextBox" Grid.Row="1" Grid.Column="3" Margin="0,2"
                                 ToolTip="Точный текст или описание показания БОИ" />
                    </Grid>

                    <Border Grid.Row="2" Padding="8" Margin="0,0,0,8" Background="#EEF3F8"
                            BorderBrush="#C7D2DE" BorderThickness="1">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Циклов:" VerticalAlignment="Center" Margin="4" />
                                <ComboBox x:Name="BenchCycleCountCombo" Width="70" Margin="0,2,10,2" />
                                <Button x:Name="CaptureNormalButton" Content="1. Записать норму"
                                        Click="CaptureNormalButton_Click" />
                                <Button x:Name="CaptureChangedButton" Content="2. Записать изменение"
                                        Click="CaptureChangedButton_Click" IsEnabled="False" />
                                <Button x:Name="StopBenchCaptureButton" Content="Остановить запись"
                                        Click="StopBenchCaptureButton_Click" IsEnabled="False" />
                                <Button x:Name="SaveBenchReportButton" Content="Сохранить отчёт CSV"
                                        Click="SaveBenchReportButton_Click" IsEnabled="False" />
                                <Button Content="Сбросить сравнение" Click="ResetBenchButton_Click" />
                                <CheckBox x:Name="OnlyChangedCheckBox" Content="Только изменения" IsChecked="True"
                                          VerticalAlignment="Center" Margin="14,4"
                                          Checked="OnlyChangedCheckBox_Changed" Unchecked="OnlyChangedCheckBox_Changed" />
                            </WrapPanel>
                            <Grid Margin="4,5,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="BenchProgressBar" Grid.Column="0" Height="16" Minimum="0" Maximum="20" />
                                <TextBlock x:Name="BenchCaptureStatusText" Grid.Column="1" Margin="10,0,0,0"
                                           Text="Сначала подключитесь к ОНК-160 и запишите норму." TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock x:Name="BenchSummaryText" Margin="4,5,4,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="3" x:Name="BenchComparisonGrid" ItemsSource="{Binding BenchComparison}"
                              AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                        <Setter Property="Background" Value="#FFF2B8" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Пакет" Binding="{Binding HeaderText}" Width="65" />
                            <DataGridTextColumn Header="Поле" Binding="{Binding Field}" Width="135" />
                            <DataGridTextColumn Header="Норма" Binding="{Binding NormalHex}" Width="70" />
                            <DataGridTextColumn Header="Изменение" Binding="{Binding ChangedHex}" Width="85" />
                            <DataGridTextColumn Header="XOR" Binding="{Binding XorHex}" Width="65" />
                            <DataGridTextColumn Header="Изменённые биты (номер: было→стало)" Binding="{Binding ChangedBits}" Width="250" />
                            <DataGridTextColumn Header="Стабильность, норма" Binding="{Binding NormalStabilityText}" Width="135" />
                            <DataGridTextColumn Header="Стабильность, изменение" Binding="{Binding ChangedStabilityText}" Width="155" />
                            <DataGridTextColumn Header="Наличие пакета" Binding="{Binding PresenceText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Пакеты и статистика">
                <DataGrid x:Name="StatisticsGrid" ItemsSource="{Binding Statistics}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                        <DataGridTextColumn Header="Кадров" Binding="{Binding Count}" Width="90" />
                        <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="60" />
                        <DataGridTextColumn Header="Средний период, мс" Binding="{Binding AveragePeriodMilliseconds, StringFormat=F2}" Width="150" />
                        <DataGridTextColumn Header="Мин., мс" Binding="{Binding MinimumPeriodMilliseconds, StringFormat=F2}" Width="110" />
                        <DataGridTextColumn Header="Макс., мс" Binding="{Binding MaximumPeriodMilliseconds, StringFormat=F2}" Width="110" />
                        <DataGridTextColumn Header="Последний кадр" Binding="{Binding LastSeen}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Профиль системы">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="ProfileText" IsReadOnly="True" BorderThickness="0" Padding="14"
                             FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
