<Window x:Class="CraneCAN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CraneCAN 0.6 — Generic Guided Diagnostics"
        Height="820"
        Width="1400"
        MinHeight="650"
        MinWidth="1080">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEF3F8" BorderBrush="#C7D2DE"
                BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="OpenTrcButton" Content="Открыть PCAN-View TRC"
                            Click="OpenTrcButton_Click" Padding="14,5" />
                    <Button x:Name="ClearButton" Content="Очистить" Click="ClearButton_Click" />
                </WrapPanel>
                <TextBlock x:Name="LoadedFileText" Grid.Column="1" Margin="12,0"
                           Text="TRC не открыт" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="ID:" VerticalAlignment="Center" Margin="4" />
                    <TextBox x:Name="IdFilterTextBox" Width="145" TextChanged="FrameFilter_Changed"
                             ToolTip="Например: 18F или 0x0CFF5321. Несколько ID — через запятую." />
                    <TextBlock Text="Формат:" VerticalAlignment="Center" Margin="12,4,4,4" />
                    <ComboBox x:Name="FormatFilterCombo" Width="110"
                              SelectionChanged="FrameFilter_Changed" />
                </WrapPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Offline-анализ TRC. Передача CAN архитектурно отсутствует." />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="FrameCountText" Text="Кадров: 0" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs" Margin="8">
            <TabItem Header="Диагностика">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12" Margin="0,0,0,8" Background="#EAF4FC"
                            BorderBrush="#8CB6D8" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Новая диагностика неизвестной машины" FontSize="18" FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0" Foreground="#425466" TextWrapping="Wrap"
                                           Text="CraneCAN ищет кандидатов по физическому эксперименту. Результат является наблюдаемой корреляцией, а не автоматическим подтверждением внутренней логики ECU." />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="Открыть эксперимент…" Click="OpenGuidedExperimentButton_Click" />
                                <Button Content="Сохранить эксперимент…" Click="SaveGuidedExperimentButton_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="1. Что вы хотите найти?" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип:" Margin="4" VerticalAlignment="Center" />
                                <ComboBox x:Name="GuidedActionTypeCombo" Grid.Row="0" Grid.Column="1" Margin="4" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Действие:" Margin="4" VerticalAlignment="Center" />
                                <TextBox x:Name="GuidedActionNameTextBox" Grid.Row="1" Grid.Column="1" Margin="4"
                                         Text="Joystick EXTEND" ToolTip="Название физического действия понятными словами" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Профиль машины" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Машина:" Margin="4" VerticalAlignment="Center" />
                                <TextBox x:Name="MachineNameTextBox" Grid.Row="0" Grid.Column="1" Margin="4" Text="Неизвестная машина" />
                                <WrapPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="Новый" Click="NewProfileButton_Click" />
                                    <Button Content="Открыть…" Click="OpenProfileButton_Click" />
                                    <Button Content="Сохранить…" Click="SaveProfileButton_Click" />
                                </WrapPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="ManufacturerTextBox" Width="130" Margin="4" Text="unknown" ToolTip="Manufacturer" />
                                    <TextBox x:Name="MachineModelTextBox" Width="130" Margin="4" Text="unknown" ToolTip="Model" />
                                    <TextBox x:Name="CanBusTextBox" Width="80" Margin="4" Text="CAN1" ToolTip="CAN bus" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="2. Укажите спокойное состояние REFERENCE и действие ACTION в открытом TRC" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="REFERENCE, мс:" Margin="4" VerticalAlignment="Center" />
                            <TextBox x:Name="GuidedReferenceStartTextBox" Grid.Column="1" Text="0" Margin="4" />
                            <TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" />
                            <TextBox x:Name="GuidedReferenceEndTextBox" Grid.Column="3" Text="10000" Margin="4" />
                            <TextBlock Grid.Column="5" Text="ACTION, мс:" Margin="4" VerticalAlignment="Center" />
                            <TextBox x:Name="GuidedActionStartTextBox" Grid.Column="6" Text="10000" Margin="4" />
                            <TextBlock Grid.Column="7" Text="—" VerticalAlignment="Center" />
                            <TextBox x:Name="GuidedActionEndTextBox" Grid.Column="8" Text="20000" Margin="4" />
                            <TextBlock Grid.Column="10" Text="Действие ≈, мс:" Margin="4" VerticalAlignment="Center" />
                            <TextBox x:Name="GuidedApproximateTimeTextBox" Grid.Column="11" Margin="4" ToolTip="Можно оставить пустым для автоматического поиска" />
                            <TextBlock Grid.Column="12" Text="±, мс:" Margin="4" VerticalAlignment="Center" />
                            <TextBox x:Name="GuidedToleranceTextBox" Grid.Column="13" Text="2000" Margin="4" />
                            <Button Grid.Column="14" Content="Добавить повтор" Click="AddGuidedRepeatButton_Click"
                                    HorizontalAlignment="Left" Padding="14,5" Margin="10,0,0,0" />
                        </Grid>
                    </GroupBox>

                    <Border Grid.Row="3" Margin="0,8" Padding="8" Background="#F5F8FB"
                            BorderBrush="#C7D2DE" BorderThickness="1">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button x:Name="AnalyzeGuidedButton" Content="3. АНАЛИЗИРОВАТЬ" Click="AnalyzeGuidedButton_Click"
                                        Padding="18,7" FontWeight="Bold" />
                            </WrapPanel>
                            <StackPanel>
                                <TextBlock x:Name="GuidedRepeatsText" Text="Повторы ещё не добавлены." FontWeight="SemiBold" />
                                <TextBlock x:Name="GuidedQualityText" Margin="0,3,0,0" Text="Качество эксперимента ещё не оценено."
                                           Foreground="#586574" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="4" x:Name="GuidedCandidatesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="GuidedCandidatesGrid_SelectionChanged"
                              EnableRowVirtualization="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" />
                            <DataGridTextColumn Header="Действие" Binding="{Binding ActionName}" Width="150" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="95" />
                            <DataGridTextColumn Header="Вывод" Binding="{Binding Interpretation}" Width="*" />
                            <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" Width="75" />
                            <DataGridTextColumn Header="Повторяемость" Binding="{Binding RepeatabilityText}" Width="110" />
                            <DataGridTextColumn Header="Реакция" Binding="{Binding ReactionText}" Width="95" />
                            <DataGridTextColumn Header="Стабильность" Binding="{Binding AgreementText}" Width="105" />
                            <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="95" />
                            <DataGridTextColumn Header="Место" Binding="{Binding LocationText}" Width="125" />
                            <DataGridTextColumn Header="Переход" Binding="{Binding TransitionText}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="5" Margin="0,8,0,0" Padding="8" Background="#FFFDF5"
                            BorderBrush="#D8C98C" BorderThickness="1">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <ComboBox x:Name="ProfileStatusCombo" Width="115" Margin="4" />
                                <Button Content="Добавить выбранный в профиль" Click="AddCandidateToProfileButton_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="GuidedCandidateDetailsText" Text="Выберите кандидата, чтобы увидеть прозрачное объяснение score."
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Generic CAN — кадры">
                <DataGrid x:Name="FramesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding TimeText}" Width="145" />
                        <DataGridTextColumn Header="От начала, мс" Binding="{Binding OffsetText}" Width="105" />
                        <DataGridTextColumn Header="Δt, мс" Binding="{Binding DeltaText}" Width="80" />
                        <DataGridTextColumn Header="Напр." Binding="{Binding Direction}" Width="60" />
                        <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="100" />
                        <DataGridTextColumn Header="Формат" Binding="{Binding FormatText}" Width="85" />
                        <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="55" />
                        <DataGridTextColumn Header="DATA" Binding="{Binding DataText}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Статистика по ID">
                <DataGrid x:Name="StatisticsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="110" />
                        <DataGridTextColumn Header="Формат" Binding="{Binding FormatText}" Width="90" />
                        <DataGridTextColumn Header="Кадров" Binding="{Binding Count, StringFormat=N0}" Width="90" />
                        <DataGridTextColumn Header="DLC" Binding="{Binding DlcValues}" Width="70" />
                        <DataGridTextColumn Header="Частота, Гц" Binding="{Binding FrequencyHertz, StringFormat=F2}" Width="110" />
                        <DataGridTextColumn Header="Средний период, мс" Binding="{Binding AveragePeriodMilliseconds, StringFormat=F3}" Width="145" />
                        <DataGridTextColumn Header="Мин., мс" Binding="{Binding MinimumPeriodMilliseconds, StringFormat=F3}" Width="100" />
                        <DataGridTextColumn Header="Макс., мс" Binding="{Binding MaximumPeriodMilliseconds, StringFormat=F3}" Width="100" />
                        <DataGridTextColumn Header="Первый кадр" Binding="{Binding FirstSeen, StringFormat=HH:mm:ss.ffff}" Width="135" />
                        <DataGridTextColumn Header="Последний кадр" Binding="{Binding LastSeen, StringFormat=HH:mm:ss.ffff}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="REFERENCE → ACTION">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10" Margin="0,0,0,8" Background="#F5F8FB"
                            BorderBrush="#C7D2DE" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="Полевое сравнение устойчивых состояний Classical CAN"
                                       FontWeight="Bold" FontSize="15" />
                            <TextBlock Margin="0,4,0,0" Foreground="#586574" TextWrapping="Wrap"
                                       Text="Выберите два окна одного TRC либо два отдельных TRC. По умолчанию показаны только устойчивые значимые изменения; аналоговый шум остаётся доступен в полном результате." />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Вариант A — два окна открытого TRC" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="REFERENCE, мс:" VerticalAlignment="Center" Margin="2,4" />
                                <TextBox x:Name="ReferenceStartTextBox" Grid.Row="0" Grid.Column="1" Text="0" Margin="4,2" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="—" VerticalAlignment="Center" />
                                <TextBox x:Name="ReferenceEndTextBox" Grid.Row="0" Grid.Column="3" Text="10000" Margin="4,2" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ACTION, мс:" VerticalAlignment="Center" Margin="2,4" />
                                <TextBox x:Name="ActionStartTextBox" Grid.Row="1" Grid.Column="1" Text="10000" Margin="4,2" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="—" VerticalAlignment="Center" />
                                <TextBox x:Name="ActionEndTextBox" Grid.Row="1" Grid.Column="3" Text="20000" Margin="4,2" />
                                <Button x:Name="CompareWindowsButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="4"
                                        Content="Сравнить окна" Click="CompareWindowsButton_Click"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,2" Padding="14,5" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Вариант B — два отдельных TRC" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Content="REFERENCE TRC…" Click="SelectReferenceFileButton_Click" />
                                <TextBlock x:Name="ReferenceFileText" Grid.Row="0" Grid.Column="1" Text="не выбран"
                                           VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Row="1" Grid.Column="0" Content="ACTION TRC…" Click="SelectActionFileButton_Click" />
                                <TextBlock x:Name="ActionFileText" Grid.Row="1" Grid.Column="1" Text="не выбран"
                                           VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="CompareFilesButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                        Content="Сравнить файлы" Click="CompareFilesButton_Click"
                                        VerticalAlignment="Center" Padding="14,5" />
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,8" Padding="8" Background="#EEF3F8"
                            BorderBrush="#C7D2DE" BorderThickness="1">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <CheckBox x:Name="OnlySignificantCheckBox" Content="Только значимые изменения"
                                          IsChecked="True" VerticalAlignment="Center" Margin="8,4"
                                          Checked="ComparisonFilter_Changed" Unchecked="ComparisonFilter_Changed" />
                                <Button x:Name="SaveComparisonButton" Content="Сохранить результат CSV"
                                        Click="SaveComparisonButton_Click" IsEnabled="False" />
                            </WrapPanel>
                            <TextBlock x:Name="ComparisonSummaryText" Text="Сравнение ещё не выполнено."
                                       VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <DataGrid Grid.Row="3" x:Name="ComparisonGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True" GridLinesVisibility="Horizontal">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PriorityKey}" Value="VeryHigh">
                                        <Setter Property="Background" Value="#FFD8A8" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PriorityKey}" Value="High">
                                        <Setter Property="Background" Value="#FFF2B8" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PriorityKey}" Value="Low">
                                        <Setter Property="Foreground" Value="#6A7480" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Приоритет" Binding="{Binding PriorityText}" Width="95" />
                            <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="100" />
                            <DataGridTextColumn Header="Формат" Binding="{Binding FormatText}" Width="85" />
                            <DataGridTextColumn Header="Поле" Binding="{Binding Field}" Width="90" />
                            <DataGridTextColumn Header="REFERENCE" Binding="{Binding ReferenceHex}" Width="90" />
                            <DataGridTextColumn Header="ACTION" Binding="{Binding ActionHex}" Width="80" />
                            <DataGridTextColumn Header="XOR" Binding="{Binding XorHex}" Width="65" />
                            <DataGridTextColumn Header="Изменившиеся биты" Binding="{Binding ChangedBits}" Width="220" />
                            <DataGridTextColumn Header="Образцы R/A" Binding="{Binding SampleText}" Width="105" />
                            <DataGridTextColumn Header="Стабильность R/A" Binding="{Binding StabilityText}" Width="130" />
                            <DataGridTextColumn Header="Классификация" Binding="{Binding Classification}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="SOOSAN regression">
                <TextBox x:Name="FieldGuideTextBox" IsReadOnly="True" BorderThickness="0" Padding="14"
                         FontFamily="Segoe UI" FontSize="14" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
