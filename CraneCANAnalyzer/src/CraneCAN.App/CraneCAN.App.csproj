<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CraneCAN.Live</AssemblyName>
    <RootNamespace>CraneCAN.App</RootNamespace>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <Product>CraneCAN — Live Guided Diagnostics</Product>
    <Description>Пассивная управляемая Live/Replay-диагностика неизвестных Classical CAN сетей.</Description>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CraneCAN.Core\CraneCAN.Core.csproj" />
    <ProjectReference Include="..\CraneCAN.Driver.PcanBasic\CraneCAN.Driver.PcanBasic.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\README.md">
      <Link>README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>README.md</TargetPath>
    </Content>
    <Content Include="..\..\docs\SOOSAN_FIELD_CAPTURE.md">
      <Link>docs\SOOSAN_FIELD_CAPTURE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>docs\SOOSAN_FIELD_CAPTURE.md</TargetPath>
    </Content>
    <Content Include="..\..\docs\GENERIC_GUIDED_DIAGNOSTICS.md">
      <Link>docs\GENERIC_GUIDED_DIAGNOSTICS.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>docs\GENERIC_GUIDED_DIAGNOSTICS.md</TargetPath>
    </Content>
    <Content Include="..\..\docs\LIVE_GUIDED_DIAGNOSTICS.md">
      <Link>docs\LIVE_GUIDED_DIAGNOSTICS.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>docs\LIVE_GUIDED_DIAGNOSTICS.md</TargetPath>
    </Content>
    <Content Include="..\..\tests\CraneCAN.SmokeTests\Fixtures\soosan_mixed.trc">
      <Link>samples\soosan_mixed.trc</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>samples\soosan_mixed.trc</TargetPath>
    </Content>
    <Content Include="..\..\tests\CraneCAN.SmokeTests\Fixtures\live_guided_demo.trc">
      <Link>samples\live_guided_demo.trc</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>samples\live_guided_demo.trc</TargetPath>
    </Content>
  </ItemGroup>
</Project>
